# URL base del backend de autenticación (POST /registro, /login, /recuperar).
# Vacío = modo demostración sin servidor.
VITE_API_URL=
# URL del patrón LangGraph que atiende el chat (POST /api/chat). Vacío = chat en modo demostración.
VITE_CHAT_URL=
# El backend aún no publica la API de inventario; dejar vacío conserva el modo demostración.
VITE_INVENTORY_URL=
# URL raíz del backend para asientos contables. Vacío = función no disponible (sin datos ficticios).
VITE_ACCOUNTING_URL=
